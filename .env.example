# ===================================================
# 迈康 MyCare · 环境变量示例
# 使用方法：复制本文件为 .env.local，按需填入你自己的 Key
# 说明：所有变量均为「可选」，全部留空也能完整运行（走本地推理降级模式）
# 注意：.env.local 含密钥，不要提交到代码仓库，也不要随材料外发
# ===================================================

# ---------- 大模型（智能体的大脑）----------
# 获取地址：https://platform.deepseek.com/api_keys
# 留空 = 启用本地推理降级模式（规则判定、达标率、预警等级照常输出）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 旧名 deepseek-chat 已下线，请求会被路由到 deepseek-flash
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=0.6
DEEPSEEK_TIMEOUT_MS=120000

# ---------- 可选：视觉模型（多模态图像解读）----------
# 不配置时，图像解读自动降级为「前端 OCR + 文本模型」，功能仍可用
# 示例：阿里云百炼 DashScope 的 OpenAI 兼容端点
VISION_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-max

# ---------- 可选：服务端 ----------
PORT=3001
# 是否允许「模型不可用 / 调用失败时降级为本地推理引擎」。
# true（默认） = 保证演示流程不中断；
# false       = 排障模式：无 Key 直接报错，模型调用失败原样抛出 401/超时等真实错误
#               （用来确认 Key 到底有没有被读到，避免被「安静降级」掩盖）
ALLOW_MOCK_FALLBACK=true

# ===================================================
# 注意：MYCARE_DB_PATH（数据库路径）不能写在这里！
# 它由 server/data/db.js 直接读取 process.env，不经过本文件的解析，
# 写在此处既不会生效也不会报错。请在启动命令前设置，例如：
#   Windows cmd        set MYCARE_DB_PATH=data/mycare-demo.db && npm run dev:server
#   PowerShell        $env:MYCARE_DB_PATH="data/mycare-demo.db"; npm run dev:server
#   macOS / Linux     MYCARE_DB_PATH=data/mycare-demo.db npm run dev:server
# ===================================================
