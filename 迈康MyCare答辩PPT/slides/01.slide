<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', flexDirection: 'column' }}>
  {/* 顶部深蓝条 */}
  <Box style={{ width: '100%', height: 12, background: '#0E3F8C' }} />
  {/* 主标题区 */}
  <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 22, padding: '0 100px' }}>
    <Text style={{ fontSize: 22, color: '#3D7BD9', letterSpacing: 6, fontWeight: 600 }}>2026 年（第 3 届）全国大学生数智链应用大赛 · 智能体赛道</Text>
    <Text style={{ fontSize: 72, fontWeight: 'bold', color: '#0E3F8C', letterSpacing: 2 }}>迈康 MyCare</Text>
    <Text style={{ fontSize: 34, fontWeight: 600, color: '#1E4FA8' }}>老年慢病多智能体协同健康管理平台</Text>
    <Text style={{ fontSize: 19, color: '#8B97A8', fontFamily: 'Times New Roman, serif', fontStyle: 'italic' }}>
      A Multi-Agent Collaborative Platform for Elderly Chronic Disease Management
    </Text>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 18, marginTop: 14 }}>
      <Box style={{ background: '#1E4FA8', borderRadius: 24, padding: '10px 30px' }}>
        <Text style={{ fontSize: 22, color: '#FFFFFF', fontWeight: 600 }}>医学判定交代码 · 表达交模型</Text>
      </Box>
      <Box style={{ background: '#E8EFF8', borderRadius: 24, padding: '10px 26px' }}>
        <Text style={{ fontSize: 20, color: '#1E4FA8', fontWeight: 600 }}>自主决策 · 环境感知 · 多模态交互</Text>
      </Box>
    </Box>
  </Box>
  {/* 底部信息条 */}
  <Box style={{ width: '100%', flexDirection: 'column', alignItems: 'center', gap: 14, paddingBottom: 44 }}>
    <Box style={{ width: 720, height: 1, background: '#D6DCE5' }} />
    <Box style={{ flexDirection: 'row', gap: 60 }}>
      <Text style={{ fontSize: 18, color: '#4A5568' }}>学校名称：______________</Text>
      <Text style={{ fontSize: 18, color: '#4A5568' }}>团队队长：______________</Text>
      <Text style={{ fontSize: 18, color: '#4A5568' }}>指导教师：______________</Text>
