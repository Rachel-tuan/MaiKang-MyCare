<Slide style={{ width: 1280, height: 720, background: '#F7F9FC', flexDirection: 'column' }}>
  {/* 页眉 A3 */}
  <Box style={{ width: '100%', height: 80, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', padding: '0 40px', gap: 16 }}>
    <Box style={{ width: 6, height: 36, background: '#FFC107' }} />
    <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#FFFFFF' }}>确定性规则引擎：13 条规则</Text>
    <Text style={{ fontSize: 17, color: '#C9D8F0', marginLeft: 18 }}>clinicalRules.js · 唯一判定实现</Text>
  </Box>
  {/* 内容区：三栏 */}
  <Box style={{ height: 580, flexDirection: 'row', padding: '20px 40px', gap: 20 }}>
    {/* 血压 4 条 */}
    <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 12, padding: 18, flexDirection: 'column', gap: 10 }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ background: '#1E4FA8', borderRadius: 6, padding: '4px 12px' }}>
          <Text style={{ fontSize: 16, color: '#FFFFFF', fontWeight: 600 }}>血压规则 · 4 条</Text>
        </Box>
      </Box>
      <Box style={{ flex: 1, flexDirection: 'column', gap: 8 }}>
        <Box style={{ background: '#F0F5FC', borderRadius: 8, padding: '10px 12px', flex: 1 }}>
          <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1A2230' }}>R-BP-1 单次超标提示</Text>
          <Text style={{ fontSize: 14, color: '#4A5568' }}>单日 ≥140/90 且前日未超标 → 提示</Text>
        </Box>
        <Box style={{ background: '#F0F5FC', borderRadius: 8, padding: '10px 12px', flex: 1 }}>
          <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1A2230' }}>R-BP-2 连续异常趋势</Text>
          <Text style={{ fontSize: 14, color: '#4A5568' }}>连续 ≥3 天且 7 天涨幅 ≥10 → 预警</Text>
        </Box>
        <Box style={{ background: '#F0F5FC', borderRadius: 8, padding: '10px 12px', flex: 1 }}>
          <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1A2230' }}>R-BP-3 严重超标强预警</Text>
          <Text style={{ fontSize: 14, color: '#4A5568' }}>≥180/110 或伴症状 → 紧急</Text>
        </Box>
        <Box style={{ background: '#F0F5FC', borderRadius: 8, padding: '10px 12px', flex: 1 }}>
          <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1A2230' }}>R-BP-4 通知紧急联系人</Text>
          <Text style={{ fontSize: 14, color: '#4A5568' }}>需授权 + 用户确认，默认不发</Text>
        </Box>
      </Box>
    </Box>
    {/* 血糖 4 条 */}
    <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 12, padding: 18, flexDirection: 'column', gap: 10 }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ background: '#1E4FA8', borderRadius: 6, padding: '4px 12px' }}>
          <Text style={{ fontSize: 16, color: '#FFFFFF', fontWeight: 600 }}>血糖规则 · 4 条</Text>
        </Box>
      </Box>
      <Box style={{ flex: 1, flexDirection: 'column', gap: 8 }}>
        <Box style={{ background: '#F0F5FC', borderRadius: 8, padding: '10px 12px', flex: 1 }}>
          <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1A2230' }}>R-BG-1 单次超标提示</Text>
          <Text style={{ fontSize: 14, color: '#4A5568' }}>空腹血糖超阈值且前日达标 → 提示</Text>
        </Box>
        <Box style={{ background: '#F0F5FC', borderRadius: 8, padding: '10px 12px', flex: 1 }}>
          <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1A2230' }}>R-BG-2 血糖波动提醒</Text>
          <Text style={{ fontSize: 14, color: '#4A5568' }}>7 天极差 ≥1.4 mmol/L → 关注</Text>
        </Box>
        <Box style={{ background: '#F0F5FC', borderRadius: 8, padding: '10px 12px', flex: 1 }}>
          <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1A2230' }}>R-BG-3 控制不佳趋势</Text>
          <Text style={{ fontSize: 14, color: '#4A5568' }}>7 天达标率 &lt;60% 且向上 → 预警</Text>
        </Box>
        <Box style={{ background: '#F0F5FC', borderRadius: 8, padding: '10px 12px', flex: 1 }}>
          <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1A2230' }}>R-BG-4 复查提醒</Text>
          <Text style={{ fontSize: 14, color: '#4A5568' }}>距上次 HbA1c &gt;3 个月 → 提示</Text>
        </Box>
      </Box>
    </Box>
    {/* 体重与行为 5 条 */}
    <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 12, padding: 18, flexDirection: 'column', gap: 10 }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ background: '#1E4FA8', borderRadius: 6, padding: '4px 12px' }}>
          <Text style={{ fontSize: 16, color: '#FFFFFF', fontWeight: 600 }}>体重与行为 · 5 条</Text>
        </Box>
      </Box>
      <Box style={{ flex: 1, flexDirection: 'column', gap: 8 }}>
        <Box style={{ background: '#F0F5FC', borderRadius: 8, padding: '10px 12px', flex: 1 }}>
          <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1A2230' }}>R-WT-1 记录达成 / R-WT-2 减重进展</Text>
          <Text style={{ fontSize: 14, color: '#4A5568' }}>当日有记录 → 提示 · 7 天净减 ≥0.5kg → 小结</Text>
        </Box>
        <Box style={{ background: '#F0F5FC', borderRadius: 8, padding: '10px 12px', flex: 1 }}>
          <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1A2230' }}>R-WT-3 短期反弹提醒</Text>
          <Text style={{ fontSize: 14, color: '#4A5568' }}>单日回升 ≥0.5kg → 柔性关注</Text>
        </Box>
        <Box style={{ background: '#F0F5FC', borderRadius: 8, padding: '10px 12px', flex: 1 }}>
          <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1A2230' }}>R-WT-4 运动达标激励</Text>
          <Text style={{ fontSize: 14, color: '#4A5568' }}>≥8000 步 或 ≥150 分钟 / 周</Text>
        </Box>
        <Box style={{ background: '#F0F5FC', borderRadius: 8, padding: '10px 12px', flex: 1 }}>
          <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1A2230' }}>R-WT-5 勋章进度跟进</Text>
          <Text style={{ fontSize: 14, color: '#4A5568' }}>展示未解锁勋章进度与目标</Text>
        </Box>
      </Box>
    </Box>
  </Box>
  {/* 底部锚点条 */}
  <Box style={{ height: 52, background: '#1E4FA8', flexDirection: 'row', alignItems: 'center', justifyContent: 'center', gap: 14 }}>
    <Text style={{ fontSize: 19, color: '#FFFFFF', fontWeight: 600 }}>
      阈值全部写死在 clinicalRules.js，无第二套隐藏阈值 —— 模型只转述，不自定阈值或等级
    </Text>
  </Box>
</Slide>
