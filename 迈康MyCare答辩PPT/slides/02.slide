<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', flexDirection: 'row' }}>
  {/* 左深蓝栏 */}
  <Box style={{ width: 360, height: '100%', background: '#0E3F8C', flexDirection: 'column', justifyContent: 'center', padding: '0 48px', gap: 18 }}>
